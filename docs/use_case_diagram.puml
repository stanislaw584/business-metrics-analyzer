@startuml
left to right direction
skinparam dpi 220
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 12
skinparam ArrowColor #44546A
skinparam ArrowThickness 1.2
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #DCE8F5
  FontStyle bold
}
skinparam usecase {
  BackgroundColor #EEF4FB
  BorderColor #2F5D8A
  BorderThickness 1.3
}
skinparam rectangle {
  BorderColor #2F5D8A
  BorderThickness 1.5
  BackgroundColor #FBFCFE
  FontStyle bold
  FontSize 15
}

title Use Case-диаграмма системы Business Metrics Analyzer

actor "Коммерческий\nдиректор" as CD
actor "Руководитель\nотдела" as RO
actor "Менеджер\nпо продажам" as MP

rectangle "Business Metrics Analyzer" {
  usecase "Уведомления о KPI" as UC8
  usecase "Просмотр дашборда KPI" as UC1
  usecase "Сравнение с предыдущим\nпериодом" as UC7
  usecase "Расчёт KPI" as UCK
  usecase "Формирование отчёта" as UC2
  usecase "Экспорт отчёта в Excel" as UC4
  usecase "Загрузка данных о продажах" as UC3
  usecase "Проверка формата файла" as UCV
  usecase "Настройка метрик\n(плановые значения)" as UC6
  usecase "Управление пользователями" as UC5
  usecase "Авторизация" as UC0
}

actor "Аналитик" as AN
actor "Администратор" as AD

CD --> UC8
CD --> UC1
CD --> UC2
RO --> UC1
RO --> UC2
MP --> UC1
MP --> UC3

UC1 <-- AN
UC2 <-- AN
UC4 <-- AN
UC3 <-- AN
UC6 <-- AN
UC5 <-- AD

UC1 ..> UCK : <<include>>
UC2 ..> UCK : <<include>>
UC3 ..> UCV : <<include>>
UC7 ..> UC1 : <<extend>>
UC4 ..> UC2 : <<extend>>

note "Авторизация обязательна\nдля всех акторов" as N0
N0 .. UC0
@enduml
