@startuml
entity "users" as user {
 *id : integer <<PK>>
 --
 username : varchar(50) <<UNIQUE>>
 email : varchar(100) <<UNIQUE>>
 password_hash : varchar(255)
 role : varchar(20)
 created_at : timestamp
}
entity "products" as product {
 *id : integer <<PK>>
 --
 name : varchar(100)
 category : varchar(50)
 price : numeric(10,2)
 description : text
}
entity "sales" as sale {
 *id : integer <<PK>>
 --
 sale_date : date
 month : varchar(7)
 revenue : numeric(12,2)
 cost : numeric(12,2)
 orders_count : integer
 product_id : integer <<FK>>
 manager_id : integer <<FK>>
}
entity "metric_settings" as metric {
 *id : integer <<PK>>
 --
 metric_name : varchar(50) <<UNIQUE>>
 formula : text
 is_active : boolean
}
entity "kpi" as kpi {
 *id : integer <<PK>>
 --
 period : varchar(7)
 metric_name : varchar(50) <<FK>>
 value : numeric(12,4)
 calculated_at : timestamp
}
entity "reports" as report {
 *id : integer <<PK>>
 --
 report_type : varchar(30)
 period : varchar(7)
 file_path : varchar(255)
 created_by : integer <<FK>>
 created_at : timestamp
}
user ||--o{ sale
product ||--o{ sale
user ||--o{ report
metric ||--o{ kpi
@enduml
